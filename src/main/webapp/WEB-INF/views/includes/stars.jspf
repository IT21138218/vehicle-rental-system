<%-- Five stars for a rating. Set ${starsValue} (1-5, may be a decimal average) before including. --%>
<span class="stars" title="${starsValue} out of 5"><c:forEach begin="1" end="5" var="i"><c:choose><c:when test="${starsValue >= i}"><i class="bi bi-star-fill"></i></c:when><c:when test="${starsValue >= i - 0.5}"><i class="bi bi-star-half"></i></c:when><c:otherwise><i class="bi bi-star"></i></c:otherwise></c:choose></c:forEach></span>
